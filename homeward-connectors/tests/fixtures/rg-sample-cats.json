ictures","id":"35712498"},{"type":"pictures","id":"56438918"}]}}},{"type":"animals","id":"10059734","attributes":{"activityLevel":"Highly Active","isAdoptionPending":false,"ageString":"10 Years 2 Months","birthDate":"2016-05-09T00:00:00Z","isBirthDateExact":false,"breedString":"Domestic Short Hair (short coat)","breedPrimary":"Domestic Short Hair","breedPrimaryId":35,"isCatsOk":true,"coatLength":"Short","isCourtesyListing":false,"descriptionHtml":"<span style=\"font-family: 'times new roman', times; font-size: 12pt;\">Bettis arrived with his momma and two littermates at three weeks old. He is a bit shy at first, but he warms up for cuddles and play time. Bettis gets along well with other cats, but has never met a dog. He has a sweet disposition and a great personality. Bettis is neutered, feline leukemia negative, and his vaccinations are current. <br \/>Won't you consider giving this cute&nbsp;cat a forever home?<\/span>","descriptionText":"Bettis arrived with his momma and two littermates at three weeks old. He is a bit shy at first, but he warms up for cuddles and play time. Bettis gets along well with other cats, but has never met a dog. He has a sweet disposition and a great personality. Bettis is neutered, feline leukemia negative, and his vaccinations are current. Won't you consider giving this cute&nbsp;cat a forever home?","isNeedingFoster":false,"isFound":false,"priority":10,"isHousetrained":true,"indoorOutdoor":"Indoor Only","isKidsOk":true,"name":"Bettis","pictureCount":2,"pictureThumbnailUrl":"https:\/\/cdn.rescuegroups.org\/27\/pictures\/animals\/10059\/10059734\/41339662.jpg?width=100","searchString":"Bettis   Black and White Male    Cats Domestic Short Hair (short coat)s","sex":"Male","sizeCurrent":11.800000190734863,"sizeUOM":"Pounds","slug":"adopt-bettis-domestic-short-hair-cat","isSpecialNeeds":false,"isSponsorable":true,"url":"https:\/\/www.olivebranchwv.org\/animals\/detail?AnimalID=10059734","videoCount":1,"videoUrlCount":1,"createdDate":"2016-05-30T16:21:58Z","updatedDate":"2025-05-22T18:11:18Z"},"relationships":{"breeds":{"data":[{"type":"breeds","id":"35"}]},"colors":{"data":[{"type":"colors","id":"6"}]},"species":{"data":[{"type":"species","id":"3"}]},"statuses":{"data":[{"type":"statuses","id":"1"}]},"locations":{"data":[{"type":"locations","id":"1000000027"}]},"orgs":{"data":[{"type":"orgs","id":"27"}]},"pictures":{"data":[{"type":"pictures","id":"41339654"},{"type":"pictures","id":"41339662"}]},"videos":{"data":[{"type":"videos","id":"20969823"}]},"videourls":{"data":[{"type":"videourls","id":"21041841"}]}}},{"type":"animals","id":"10178313","attributes":{"activityLevel":"Moderately Active","isAdoptionPending":false,"adultSexesOk":"All","ageGroup":"Adult","ageString":"11 Years 9 Months","availableDate":"2026-03-30T00:00:00Z","birthDate":"2014-10-09T00:00:00Z","isBirthDateExact":false,"breedString":"Tuxedo \/ Domestic Medium Hair \/ Mixed (short coat)","breedPrimary":"Tuxedo","breedPrimaryId":73,"breedSecondary":"Domestic Medium Hair","breedSecondaryId":29,"isBreedMixed":true,"isCatsOk":true,"coatLength":"Short","isCourtesyListing":false,"isCurrentVaccinations":true,"isDeclawed":false,"descriptionHtml":"<div class=\"relative basis-auto flex-col -mb-(--composer-overlap-px) [--composer-overlap-px:55px] grow flex overflow-hidden\" style=\"caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-style: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: auto; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: auto; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration: none;\">\n<div class=\"relative h-full\">\n<div class=\"flex h-full flex-col overflow-y-auto thread-xl:pt-(--header-height) [scrollbar-gutter:stable_both-edges]\">\n<div class=\"flex flex-col text-sm thread-xl:pt-header-height pb-25\">\n<article class=\"text-token-text-primary w-full focus:outline-none scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]\" data-scroll-anchor=\"true\" data-testid=\"conversation-turn-2\" data-turn=\"assistant\" data-turn-id=\"request-WEB:0f37949a-592b-44dc-8c04-f5c09b9a3d01-0\" dir=\"auto\" tabindex=\"-1\">\n<div class=\"text-base my-auto mx-auto pb-10 [--thread-content-margin:--spacing(4)] thread-sm:[--thread-content-margin:--spacing(6)] thread-lg:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)\">\n<div class=\"[--thread-content-max-width:40rem] thread-lg:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group\/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn\" tabindex=\"-1\">\n<div class=\"flex max-w-full flex-col grow\">\n<div class=\"min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-5\" data-message-author-role=\"assistant\" data-message-id=\"7f85853f-c1cd-437b-a6cc-a055d1809c75\" data-message-model-slug=\"gpt-4o\" dir=\"auto\">\n<div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\">\n<div class=\"markdown prose dark:prose-invert w-full break-words light markdown-new-styling\">\n<p data-end=\"490\" data-start=\"265\">Tara is&nbsp;still learning how to trust the world. She&#39;s not the kind of cat who&rsquo;ll jump into your lap on day one&mdash;but give her time, patience, and respect, and you&rsquo;ll be rewarded with a quiet, loyal companion.<\/p>\n\n<p data-end=\"808\" data-start=\"492\">Tara is most comfortable when she has all four paws on the ground. You&#39;ll see her confidence grow when she&#39;s walking freely around the room. She&#39;s a bit defensive when tucked away in a cat tree or bed, so it&rsquo;s best to let her come to you rather than making the first move. Slow and steady is the way to Tara&rsquo;s heart.<\/p>\n\n<p data-end=\"1166\" data-start=\"810\">She would thrive in a home with someone who has experience with shy&nbsp;cats&mdash;someone who understands that trust takes time. Once she feels safe, Tara truly enjoys being petted and even seeks it out on her own terms. One of her favorite activities? Chasing the laser pointer! It&rsquo;s a great way to bond with her while keeping her active and engaged.<\/p>\n\n<p data-end=\"1342\" data-start=\"1168\">Tara doesn&rsquo;t seem particularly interested in other cats&mdash;she&rsquo;s indifferent, really&mdash;so she could do well as a solo cat or in a quiet multi-cat home where she has her own space.<\/p>\n\n<p data-end=\"1494\" data-start=\"1344\">Tara may not be the right fit for every home, but for the right person&mdash;someone calm, patient, and kind&mdash;she could be an incredibly rewarding companion.<\/p>\n\n<p data-end=\"1588\" data-start=\"1496\">&nbsp;<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/article>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<p>\n<span style=\"font-size:13.5pt;color:black\"><o:p><\/o:p><\/span>\n<\/p>","descriptionText":"\n\n\n\n\n\n\n\n\n\n\nTara is&nbsp;still learning how to trust the world. She&#39;s not the kind of cat who&rsquo;ll jump into your lap on day one&mdash;but give her time, patience, and respect, and you&rsquo;ll be rewarded with a quiet, loyal companion.\n\nTara is most comfortable when she has all four paws on the ground. You&#39;ll see her confidence grow when she&#39;s walking freely around the room. She&#39;s a bit defensive when tucked away in a cat tree or bed, so it&rsquo;s best to let her come to you rather than making the first move. Slow and steady is the way to Tara&rsquo;s heart.\n\nShe would thrive in a home with someone who has experience with shy&nbsp;cats&mdash;someone who understands that trust takes time. Once she feels safe, Tara truly enjoys being petted and even seeks it out on her own terms. One of her favorite activities? Chasing the laser pointer! It&rsquo;s a great way to bond with her while keeping her active and engaged.\n\nTara doesn&rsquo;t seem particularly interested in other cats&mdash;she&rsquo;s indifferent, really&mdash;so she could do well as a solo cat or in a quiet multi-cat home where she has her own space.\n\nTara may not be the right fit for every home, but for the right person&mdash;someone calm, patient, and kind&mdash;she could be an incredibly rewarding companion.\n\n&nbsp;\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n","energyLevel":"Moderate","exerciseNeeds":"Low","fenceNeeds":"Not Required","isNeedingFoster":false,"isFound":false,"groomingNeeds":"Not Required","priority":10,"isHousetrained":true,"indoorOutdoor":"Indoor Only","isKidsOk":false,"name":"Tara","newPeopleReaction":"Cautious","ownerExperience":"None","pictureCount":10,"pictureThumbnailUrl":"https:\/\/cdn.rescuegroups.org\/5211\/pictures\/animals\/10178\/10178313\/58063078.jpg?width=100","qualities":["oKForSeniors","olderKidsOnly","playful","playsToys","skittish","timid"],"searchString":"Tara   Black and White Female Medium   Cats Tuxedo \/ Domestic Medium Hair \/ Mixed (short coat)s","sex":"Female","sheddingLevel":"Moderate","sizeGroup":"Medium","sizeUOM":"Pounds","slug":"adopt-tara-tuxedo-cat","isSpecialNeeds":false,"isSponsorable":true,"url":"https:\/\/CatRangers.rescuegroups.org\/animals\/detail?AnimalID=10178313","videoCount":1,"videoUrlCount":1,"vocalLevel":"Some","isYardRequired":false,"createdDate":"2016-06-21T01:53:55Z","updatedDate":"2026-03-30T10:53:15Z"},"relationships":{"breeds":{"data":[{"type":"breeds","id":"73"},{"type":"breeds","id":"29"}]},"colors":{"data":[{"type":"colors","id":"6"}]},"patterns":{"data":[{"type":"patterns","id":"14"}]},"species":{"data":[{"type":"species","id":"3"}]},"statuses":{"data":[{"type":"statuses","id":"1"}]},"locations":{"data":[{"type":"locations","id":"18092"}]},"orgs":{"data":[{"type":"orgs","id":"5211"}]},"pictures":{"data":[{"type":"pictures","id":"89311739"},{"type":"pictures","id":"76960673"},{"type":"pictures","id":"62052409"},{"type":"pictures","id":"87171035"},{"type":"pictures","id":"97051692"},{"type":"pictures","id":"89