# Homeward fleet environment contract.
# Copy to ~/.config/homeward/homeward.env and fill in the values.
# All three daemons read this file via EnvironmentFile= in their unit files.
# No secret is hard-coded anywhere in deploy/; every sensitive value lives here.

# ---------------------------------------------------------------------------
# Core paths
# ---------------------------------------------------------------------------

# Absolute path to the SQLite database used by homeward-ingestd.
# Default (if unset): $HOME/.local/share/homeward/homeward-ingest.db
# HOMEWARD_DB=$HOME/.local/share/homeward/homeward-ingest.db

# ---------------------------------------------------------------------------
# Embed sidecar
# ---------------------------------------------------------------------------

# Base URL of the homeward-embed FastAPI sidecar.
# homeward-ingest and homeward-match use this to call /enroll and /query.
HOMEWARD_EMBED_URL=http://127.0.0.1:8082

# Port the sidecar listens on (must match the URL above).
# The sidecar reads this via the uv/uvicorn startup; change both together.
HOMEWARD_EMBED_PORT=8082

# ---------------------------------------------------------------------------
# Report service
# ---------------------------------------------------------------------------

# TCP port for homeward-reportd serve.
HOMEWARD_REPORT_PORT=8081

# ---------------------------------------------------------------------------
# Connector keys
# ---------------------------------------------------------------------------

# RescueGroups v5 API key.  Without this the connector is skipped; Socrata
# feeds (Austin, Dallas, Sonoma, Long Beach) work without a key.
# RESCUEGROUPS_API_KEY=your-key-here

# ---------------------------------------------------------------------------
# Socrata / open-data feeds
# ---------------------------------------------------------------------------
# Path to the source catalog TOML file.  When set, homeward-ingestd reads
# connector definitions from this file instead of (or in addition to) the
# compiled-in built-ins.  Relative paths are resolved from the working directory.
# Default (if unset): built-in Austin / Dallas / Sonoma / Long Beach only.
HOMEWARD_SOURCES=deploy/sources.toml

# Optional SODA app token — lifts anonymous rate limits for all Socrata feeds.
# Register for a free token at https://data.austintexas.gov/profile/app_tokens
# SOCRATA_APP_TOKEN=your-token-here

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Tracing level for homeward-ingestd and homeward-reportd (RUST_LOG syntax).
# RUST_LOG=info
