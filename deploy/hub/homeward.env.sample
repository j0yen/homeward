# Hub instance env — copy to ~/.config/homeward/homeward.env (mode 600).
# Every homeward-*.service under deploy/hub/systemd reads this file.
HOMEWARD_DATA_DIR=/home/jsy/.local/share/homeward
HOMEWARD_INGEST_DB=/home/jsy/.local/share/homeward/homeward-ingest.db
HOMEWARD_REPORT_PORT=8081   # note: the unit passes --port 8080 explicitly; 8080 is what listens
RESCUEGROUPS_API_KEY=
HW_EMBED_HOST=127.0.0.1
HW_EMBED_PORT=8741
